# MoveMate Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# Supabase
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# Vercel AI Gateway
# =============================================================================
AI_GATEWAY_API_KEY=your-ai-gateway-api-key

# =============================================================================
# Vercel Blob (Image Uploads)
# =============================================================================
BLOB_READ_WRITE_TOKEN=your-blob-token

# =============================================================================
# Langfuse (LLM Observability)
# =============================================================================
# Get these from https://cloud.langfuse.com/project/settings
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Set to "true" to enable tracing
LANGFUSE_ENABLED=false

# =============================================================================
# Sentry (Error Monitoring)
# =============================================================================
# Get DSN from https://sentry.io/settings/projects/{project}/keys/
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Organization and project slugs for source map uploads
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project

# Auth token for source map uploads (create at https://sentry.io/settings/auth-tokens/)
# Only needed in CI/CD, not locally
SENTRY_AUTH_TOKEN=sntrys_xxx
